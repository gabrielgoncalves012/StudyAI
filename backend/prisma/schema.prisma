// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  verified   Boolean      @default(false)
  isAdmin    Boolean      @default(false)
  dateCreated DateTime     @default(now())
  cronogramas Cronograma[]
  tokens      VerificationToken[]
  clientStripe ClientStripe[]
  usage       Usage[]
}

model Usage {
  id          String   @id @default(uuid())
  userId      String   @unique
  questoes    Int      @default(0)
  cronogramas Int      @default(0)
  isAccessCronograma Boolean  @default(false)
  periodEnd   DateTime
  dateCreated DateTime @default(now())
  dateUpdated DateTime @updatedAt

  usuario Usuario @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id         String   @id @default(uuid())
  codigo      String   @unique
  email     String
  userId     String
  tentativas Int      @default(0)
  usuario    Usuario  @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model Cronograma {
  id          String   @id @default(uuid())
  concurso    String
  cargo       String @default("")
  emojCode    String
  colorCode   String
  accessDate  String
  dateCreated String
  topicLength Int
  topicFinished Int

  userId      String
  usuario     Usuario  @relation(fields: [userId], references: [id])

  disciplinas Disciplina[]
  planejamentos Planejamento[]
  topicos     Topico[]
}

model Disciplina {
  id          String   @id @default(uuid())
  name        String
  length      Int
  finished   Int

  cronograma_id String
  cronograma    Cronograma @relation(fields: [cronograma_id], references: [id])
  
  topics      Topico[]
}

model Topico {
  id            String   @id @default(uuid())
  name          String
  finished      Boolean

  disciplina_id String
  disciplina    Disciplina @relation(fields: [disciplina_id], references: [id])
  cronograma_id String
  cronograma     Cronograma @relation(fields: [cronograma_id], references: [id])
}

model Planejamento {
  id          String   @id @default(uuid())
  day        Int
  diciplina   String
  topics      String[]

  cronograma_id String
  cronograma    Cronograma @relation(fields: [cronograma_id], references: [id])
}

model Questoes {
  id          String   @id @default(uuid())
  enunciado   String
  alternativas      String[]
  banca      String
  correta    String
  ano_aproximado Int
  dificuldade String
  topico_especifico String
  disciplina String
  topico String
}

// Paymento ---------------

model Plan {
  id String @id @default(uuid())
  name String
  price Decimal
  codigo String @unique
  stripePriceId String @unique
  resources Json
  actived Boolean @default(true)
  dateCreated DateTime @default(now())
  dateUpdated DateTime @updatedAt

  assinaturas Subscriptions[]
}

model ClientStripe {
  id String @id @default(uuid())
  name String
  email String @unique
  userId String
  stripeCustomerId String @unique
  actived Boolean @default(true)
  dateCreated DateTime @default(now())
  dateUpdated DateTime @updatedAt

  usuario Usuario @relation(fields: [userId], references: [id])

  assinaturas Subscriptions[]
}

model Subscriptions {
  id String @id @default(uuid())
  clientId String
  planId String
  stripeSubscriptionId String @unique
  status String
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  dateCreated DateTime @default(now())
  dateUpdated DateTime @updatedAt

  client ClientStripe @relation(fields: [clientId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  invoices Invoice[]
}

model Invoice {
  id String @id @default(uuid())
  subscriptionId String
  paymentId String
  price Decimal
  status String
  datePayment DateTime
  dateMaturity DateTime
  ivoicePdf String
  dateCreated DateTime @default(now())
  dateUpdated DateTime @updatedAt

  subscription Subscriptions @relation(fields: [subscriptionId], references: [id])
}

model WebhookEvent {
  id String @id @default(uuid())
  stripeEventId String @unique
  type String
  dateReceived DateTime @default(now())
  processed Boolean @default(false)
  dateProcessed DateTime
  errorMessage String
}